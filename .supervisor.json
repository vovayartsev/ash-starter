{
  "$comment": "supervisor-and-mcp-proxy config. See /README for full schema.",

  "bind": "0.0.0.0:9121",
  "auth": {
    "token": "my-super-token"
  },
  "log_buffer": 1000,
  "shutdown_grace_seconds": 10,

  "mcp_servers": {
    "serena": {
      "namespace": "serena",
      "command": "serena",
      "args": ["start-mcp-server", "--context", "desktop-app", "--project", "/workspaces/app"],
      "env": {"PATH": "/home/vscode/.local/bin:/usr/local/bin:/usr/bin:/bin"},
      "cwd": "/workspaces/app",
      "autostart": true,
      "restart_policy": {
        "mode": "on-failure",
        "max_restarts": 5,
        "window_seconds": 60,
        "backoff_seconds": 2
      }
    }
  },

  "named_tools": {
    "phx.server": {
      "command": "mix phx.server",
      "cwd": "/workspaces/app",
      "env": {
        "MIX_ENV": "dev"
      },
      "autostart": false,
      "restart_policy": {
        "mode": "never"
      }
    }
  }
}
