{
  "name": "app",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "runArgs": ["--init"],

  "containerEnv": {
    "MIX_ENV": "dev",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },

  "remoteUser": "vscode",

  "workspaceFolder": "/workspaces/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/app,type=bind,consistency=cached",

  "mounts": [
    "target=/workspaces/app/.claude,type=tmpfs"
  ],

  "forwardPorts": [4000, 9121, 24282],
  "portsAttributes": {
    "4000": { "label": "Phoenix", "onAutoForward": "notify" },
    "9121": { "label": "devcontainer", "onAutoForward": "silent" },
    "24282": { "label": "Serena dashboard", "onAutoForward": "silent" }
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "uid": "1000",
      "gid": "1000",
      "installZsh": true,
      "configureZshAsDefaultShell": false
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "postCreateCommand": "bash /workspaces/app/.devcontainer-scripts/post-create.sh",
  "postStartCommand": "bash /workspaces/app/.devcontainer-scripts/post-start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "JakeBecker.elixir-ls",
        "phoenixframework.phoenix",
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
